# Development Environment Configuration
NODE_ENV=development
PORT=3000

# Development Database Configuration
DEV_DATABASE_HOST=postgres-dev
DEV_DATABASE_PORT=5432
DEV_DATABASE_USERNAME=postgres
DEV_DATABASE_PASSWORD=postgres
DEV_DATABASE_NAME=incidents_dev

# Development JWT Configuration
DEV_JWT_SECRET=dev-jwt-secret-key-change-this
DEV_JWT_REFRESH_SECRET=dev-refresh-secret-key-change-this

# Development Encryption Configuration
DEV_ENCRYPTION_KEY=dev-encryption-key-change-this

# Development Redis Configuration
DEV_REDIS_HOST=redis-dev
DEV_REDIS_PORT=6379

# Development Application Configuration
DEV_PORT=3000

# Rate Limiting Configuration
THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Logging Configuration
LOG_LEVEL=debug
