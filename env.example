# Application Configuration
NODE_ENV=development
PORT=3000

# Production Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=your-db-username
DATABASE_PASSWORD=your-secure-db-password
DATABASE_NAME=your-db-name

# Development Database Configuration
DEV_DATABASE_HOST=localhost
DEV_DATABASE_PORT=5433
DEV_DATABASE_USERNAME=postgres
DEV_DATABASE_PASSWORD=postgres
DEV_DATABASE_NAME=incidents_dev

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production

# Development JWT Configuration
DEV_JWT_SECRET=dev-jwt-secret-key
DEV_JWT_REFRESH_SECRET=dev-refresh-secret-key

# Encryption Configuration
ENCRYPTION_KEY=your-encryption-key-change-this-in-production
DEV_ENCRYPTION_KEY=dev-encryption-key

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Development Redis Configuration
DEV_REDIS_HOST=localhost
DEV_REDIS_PORT=6380

# Development Application Configuration
DEV_PORT=3000

# Nginx Configuration
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Rate Limiting Configuration
THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Logging Configuration
LOG_LEVEL=info

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DEST=./uploads

# Email Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# External API Configuration (Optional)
EXTERNAL_API_URL=
EXTERNAL_API_KEY=
